# Copia este archivo como ".env" en la raíz del proyecto.
# Los valores coinciden con docker-compose.yml y sirven solo para desarrollo local.

# Servidor Express
PUERTO=3000

# PostgreSQL (contenedor relevo-db)
PGHOST=localhost
PGPORT=5433
PGDATABASE=relevo
PGUSER=relevo
PGPASSWORD=relevo_dev
# Secreto con el que se firman las sesiones (mínimo 32 caracteres).
# En desarrollo se puede dejar así; en producción hay que definir uno propio y secreto.
SESION_SECRETO=secreto-solo-para-desarrollo-local-no-usar-en-produccion

# Contraseña de cada cuenta de desarrollo que crea "npm run bd:semilla" (10 a 128 caracteres).
# Cada cuenta tiene la suya: la semilla se niega a repetirlas.
SEMILLA_PASSWORD_ADMINISTRADOR=Admin-Relevo-7391
SEMILLA_PASSWORD_ENCARGADO=Encargado-Relevo-4852
SEMILLA_PASSWORD_USUARIO=Usuario-Relevo-2064
