{
  "name": "relevo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Relevo: control de préstamos de equipo",
  "workspaces": [
    "servidor",
    "cliente"
  ],
  "scripts": {
    "dev": "concurrently -n servidor,cliente -c blue,green \"npm run dev -w servidor\" \"npm run dev -w cliente\"",
    "test": "npm test -w servidor",
    "build": "npm run build -w cliente",
    "bd:levantar": "docker compose up -d",
    "bd:apagar": "docker compose down",
    "bd:pruebas": "docker compose exec -T db psql -U relevo -d relevo -q -f /sql/pruebas.sql",
    "lint": "eslint .",
    "lint:arreglar": "eslint . --fix",
    "formato": "prettier --write .",
    "formato:revisar": "prettier --check .",
    "tipos": "npm run tipos --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.72.2"
  }
}
